# Copy this file to .env and fill in your real PostgreSQL credentials.
# .env is gitignored — never commit real credentials.

DB_HOST=localhost
DB_PORT=5432
DB_USER=amit
DB_PASSWORD=Admin@1234
DB_NAME=ChatApp

PORT=4000

# Secret used to sign login tokens. Generate a long random string for production,
# e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=d9049cc95eea894b32dc9948277efb0b7857411f63d8aa4614d5f6f8496b29a55e8d4e7ca61bbee1e948ae7b45ab9181

# Cloudinary is used to store uploaded media (avatars, chat images/video/audio/files)
# so uploads survive redeploys on hosts like Render whose local disk is wiped each deploy.
# Free account: https://cloudinary.com/users/register/free — values are on your Cloudinary
# dashboard under "API Environment variable" / API Keys.
CLOUDINARY_CLOUD_NAME=wuxf3n7k
CLOUDINARY_API_KEY=814852222945249
CLOUDINARY_API_SECRET=QTwfsdSme0tZith4VGoxNHav8UY

# Pusher Beams — real push notifications (arrive even when the app/tab is closed).
# Get these from your Beams instance dashboard: https://dashboard.pusher.com/beams
# Leave blank to disable push notifications entirely (everything else still works).
BEAMS_INSTANCE_ID=e577dd22-e72f-4367-8249-e94956f1ac52
BEAMS_SECRET_KEY=BBA475783CA735F53D185FAC8141553C27FE2376CB07EF6EAF15BFCF00688EBC

# Used as the deep-link target in push notifications (where tapping one should open).
# Your deployed frontend URL, e.g. https://personal-chat-front.onrender.com
CLIENT_URL=

