# Copy this file to .env and fill in your real PostgreSQL credentials.
# .env is gitignored — never commit real credentials.

DB_HOST=localhost
DB_PORT=5432
DB_USER=amit
DB_PASSWORD=Admin@1234
DB_NAME=ChatApp

PORT=4000

# Secret used to sign login tokens. Generate a long random string for production,
# e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=change_this_to_a_long_random_string
